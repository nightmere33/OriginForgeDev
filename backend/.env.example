# Copy to backend/.env and fill in. Never commit the real file.

DJANGO_DEBUG=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_ADMIN_PATH=_djadmin/

# sqlite by default; production: postgres://originforge:PASSWORD@127.0.0.1:5432/originforge
DATABASE_URL=

SITE_URL=http://localhost:3000
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_SECRET=

# Empty = Celery runs tasks inline (fine for development).
REDIS_URL=

# Empty = e-mails are printed to the runserver console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OriginForge <no-reply@originforge.local>
STUDIO_NOTIFY_EMAIL=

# Production only: nginx internal location for private files.
PRIVATE_MEDIA_ACCEL_PREFIX=

# Online payments. On the server, save each with deploy/set_secret.sh (hidden).
CHARGILY_SECRET_KEY=
CHARGILY_MODE=test
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
